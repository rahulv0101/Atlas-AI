  "source_rule_findings": [
    {
      "file": "atlas_ai/trader.py",
      "function": "_derive_runtime_chart_features",
      "finding": "Strong momentum requires at least six of eight close changes in one direction plus latest candle body/range >= 0.55; weak is body/range < 0.30; otherwise mixed. The local classifier does not emit turning, although the timing gate accepts that label from context."
    },
    {
      "file": "atlas_ai/trader.py",
      "function": "_derive_runtime_chart_features",
      "finding": "Location is a rolling 20-bar price-range heuristic, not explicit order-block/FVG/retest geometry. In a downtrend, close position >= 0.58 is pullback; in an uptrend <= 0.42 is pullback. Breakout and mid-range have separate branches. This audit does not establish how many structural setups it mislabels."
    },
    {
      "file": "atlas_ai/trader.py",
      "function": "_timing_discipline_snapshot",
      "finding": "New York extra momentum confirmation fails on the same not-momentum-confirmed condition as the general momentum check. These are overlapping reasons, not independent failed signals or proof of newly learned session performance."
    },
    {
      "file": "atlas_ai/trader.py",
      "function": "step / _attach_candidate_evidence_review",
      "finding": "Top-down signal df is filtered through closed_bars(M5). Indicator provenance still refers to market_data_clock latest raw bar and can report forming; this metadata alone does not prove the main signal used a forming candle. Exact feature-input provenance needs separate inspection."
    },
    {
      "file": "atlas_ai/trader.py",
